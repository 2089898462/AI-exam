# ============================================================
# AI考试系统（企业内部版）- 后端环境变量示例
# 复制此文件为 .env 并填入实际值
# ============================================================

# 应用配置
PROJECT_NAME=AI考试系统（企业内部版）
VERSION=0.1.0
DEBUG=True

# 数据库配置（生产环境必须修改）
# DATABASE_URL=mysql+pymysql://user:password@host:3306/exam_system
DATABASE_URL=sqlite:///./exam_system.db

# JWT 配置（生产环境必须替换为强随机密钥）
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change-me-to-a-random-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI-Service 配置
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_TIMEOUT=30.0

# 安全配置
SECURITY_PASSWORD_MIN_LENGTH=8
SECURITY_LOGIN_MAX_ATTEMPTS=5
SECURITY_LOGIN_LOCKOUT_MINUTES=15
