# ============================================================
# AI考试系统（企业内部版）- AI-Service 环境变量示例
# 复制此文件为 .env 并填入实际值
# ============================================================

# 模型配置
# 支持的 Provider: deepseek / dashscope / openai / anthropic
# 默认使用 deepseek-v4-flash
AI_MODEL_NAME=deepseek-v4-flash
AI_MODEL_PROVIDER=deepseek

# API Key（必须配置，禁止硬编码）
# 请从 DeepSeek 控制台获取: https://platform.deepseek.com/
AI_API_KEY=your-api-key-here

# API Base URL
# DeepSeek 兼容 OpenAI API 格式
AI_API_BASE=https://api.deepseek.com/v1

# 模型参数
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.3

# 服务配置
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8001
AI_REQUEST_TIMEOUT=30.0
